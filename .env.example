# Opsional: isi agar aplikasi langsung tersambung ke Firebase tanpa menempel config di menu Pengaturan.
# Salin file ini menjadi .env lalu isi nilainya dari Firebase Console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
